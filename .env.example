# SkillWeaver environment template
# Copy this file to .env and fill in the keys needed for your workflow.

# Optional: used by LLM-assisted I/O extraction and trigger-skill synthesis.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Optional: OpenAI-compatible endpoint for local or hosted agent execution.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Optional: OpenClaw runtime experiment settings.
OPENCLAW_CONTAINER=openclaw-gateway
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_MODEL=alibaba-bailian/qwen3.5-plus
